STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Production example: https://your-app.vercel.app/api/strava/callback
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Optional public app URL used to derive Strava callback if STRAVA_REDIRECT_URI is unset
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for Vercel — local JSON storage does not persist on serverless)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
